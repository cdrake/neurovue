<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The CLI merges Info.plist then this into gen/apple's plist on every build,
       replacing whole keys: edit iOS keys here, not in gen/apple (c063e97 lost
       the bundle types that way). Arrivals go through RunEvent::Opened (opened.rs). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>NeuroVue Bundle</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.neurovue.nvbundle</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>NiiVue Document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.niivue.nvd</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>NIfTI image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Default</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>gov.nih.nifti-1</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Compressed NIfTI image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.gnu.gnu-zip-archive</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.neurovue.nvbundle</string>
      <key>UTTypeDescription</key>
      <string>NeuroVue Bundle</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.zip-archive</string>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nvbundle</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>gov.nih.nifti-1</string>
      <key>UTTypeDescription</key>
      <string>NIfTI image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeReferenceURL</key>
      <string>https://nifti.nimh.nih.gov</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nii</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.niivue.nvd</string>
      <key>UTTypeDescription</key>
      <string>NiiVue Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nvd</string>
        </array>
      </dict>
    </dict>
  </array>
  <!-- UIScene life cycle (iOS 27 SDK, TN3187). tao only enters scene mode when
       this is true and supplies the configuration itself; main.mm keeps it to
       one window. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
  </dict>
  <!-- The UI is dark-only: keeps the launch screen, status bar and native sheets dark. -->
  <key>UIUserInterfaceStyle</key>
  <string>Dark</string>
</dict>
</plist>
