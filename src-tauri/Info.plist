<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Finder's Open With / double-click; arrivals go through RunEvent::Opened (opened.rs).
       gzip is Alternate so .nii.gz offers NeuroVue without taking over every .gz.
       MGH is only imported (for Quick Look): the viewer can't open it yet.
       Info.ios.plist replaces these arrays on iOS (the CLI merges key by key). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>NIfTI image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Default</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>gov.nih.nifti-1</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Compressed NIfTI image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.gnu.gnu-zip-archive</string>
      </array>
    </dict>
  </array>
  <!-- macOS 15+ local network privacy: Send to iPad browses, registers and resolves this. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>NeuroVue finds your other devices on this network to send and receive datasets and drawings you approve.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_neurovue-tls._tcp</string>
  </array>
  <!-- Quick Look matches bundles by this type (Info.ios.plist declares it on iOS). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.neurovue.nvbundle</string>
      <key>UTTypeDescription</key>
      <string>NeuroVue Bundle</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.zip-archive</string>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nvbundle</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/vnd.neurovue.bundle+zip</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>gov.nih.nifti-1</string>
      <key>UTTypeDescription</key>
      <string>NIfTI image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeReferenceURL</key>
      <string>https://nifti.nimh.nih.gov</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nii</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.freesurfer.mgz</string>
      <key>UTTypeDescription</key>
      <string>Compressed FreeSurfer MGH image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeReferenceURL</key>
      <string>https://surfer.nmr.mgh.harvard.edu/fswiki/FsTutorial/MghFormat</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mgz</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.freesurfer.mgh</string>
      <key>UTTypeDescription</key>
      <string>FreeSurfer MGH image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeReferenceURL</key>
      <string>https://surfer.nmr.mgh.harvard.edu/fswiki/FsTutorial/MghFormat</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mgh</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
