{
  "name": "neurovue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "ensure-niimath": "node scripts/ensure-niimath.cjs",
    "build-quicklook": "sh scripts/build-quicklook.sh",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@niivue/niivue": "^1.0.0-rc.37",
    "@niivue/uikit": "^1.0.0-rc.25",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "nifti-reader-js": "^0.8.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@tauri-apps/cli": "~2.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.2",
    "vite": "^5.4.11"
  }
}
